# Copy to .env (repo root for docker compose, or apps/api/.env for running the API directly).

# Postgres from docker-compose is exposed on host port 5433.
DATABASE_URL=postgresql+psycopg://pht:pht@localhost:5433/pht

# REQUIRED outside dev: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-only-change-me-dev-only-change-me
ENV=dev
CORS_ORIGINS=["http://localhost:3000"]

# Password given to every demo account created by `python -m app.seed` (demo data only).
SEED_PASSWORD=demo-password-123

